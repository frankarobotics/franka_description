<?xml version="1.0" encoding="utf-8"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="franka_robot"
    params="robot_type
                      parent:='world'
                      xyz:='0 0 0'
                      rpy:='0 0 0'
                      xyz_ee:='0 0 0'
                      rpy_ee:='0 0 0'
                      tcp_xyz:=''
                      tcp_rpy:='0 0 0'
                      safety_distance:='0.03'
                      hand:='true'
                      ee_id:=none
                      special_connection:=''
                      include_self_collision_geometry:='true'
                      with_sc:='false'
                      no_prefix:=false
                      arm_prefix:=''
                      description_pkg:='franka_description'
                      connected_to:='base'">

    <xacro:include filename="$(find franka_description)/robots/common/utils.xacro"/>

    <xacro:include filename="$(find franka_description)/robots/common/franka_arm.xacro"/>

    <!-- The tcp offset belongs to the end effector, so an empty tcp_xyz resolves to
         that end effector's own value rather than to zero. These must match the
         defaults in end_effectors/<ee_id>/<ee_id>_arguments.xacro, which
         test_tcp_offset_matches_end_effector enforces. -->
    <xacro:property name="ee_tcp_xyz"
      value="${'0 0 0.1034' if ee_id == 'franka_hand' else '0 0 0.105' if ee_id == 'cobot_pump' else '0 0 0'}"/>
    <xacro:property name="tcp_xyz_resolved" value="${ee_tcp_xyz if tcp_xyz == '' else tcp_xyz}"/>

    <!-- franka_arm derives its link names this way, so the end effector has to attach to
         the same names and prefix itself the same way, or the two halves of the robot do
         not reference each other. -->
    <xacro:property name="link_prefix" value="${'' if no_prefix else arm_prefix + robot_type + '_'}"/>

    <xacro:franka_arm
      robot_type="${robot_type}"
      arm_prefix="${arm_prefix}"
      no_prefix="${no_prefix}"
      xyz="${xyz}"
      rpy="${rpy}"
      safety_distance="0.03"
      include_self_collision_geometry="${include_self_collision_geometry}"
      with_sc="${with_sc}"
      connected_to="${connected_to}"
    />

    <xacro:if value="${hand and ee_id== 'franka_hand'}">
      <xacro:include filename="$(find franka_description)/end_effectors/common/franka_hand.xacro"/>
      <xacro:include filename="$(find franka_description)/end_effectors/common/utils.xacro"/>
      <xacro:if value="${robot_type == 'fp3'}">
        <xacro:property name="ee_color" value="black"/>
      </xacro:if>
      <xacro:if
        value="${robot_type == 'fr3' or robot_type == 'fer' or robot_type == 'fr3v2' or robot_type == 'fr3v2_1'}">
        <xacro:property name="ee_color" value="white"/>
      </xacro:if>
      <xacro:property name="connection"
        value="${arm_prefix + special_connection if special_connection != '' else link_prefix + 'link8'}"/>
      <xacro:franka_hand
        connected_to="${connection}"
        robot_type="${robot_type}"
        arm_prefix="${arm_prefix}"
        no_prefix="${no_prefix}"
        ee_id="${ee_id}_${ee_color}"
        ee_inertials="${xacro.load_yaml('$(find franka_description)/end_effectors/' + ee_id + '/inertials.yaml')}"
        rpy_ee="${rpy_ee}"
        xyz_ee="${xyz_ee}"
        tcp_xyz="${tcp_xyz_resolved}"
        tcp_rpy="${tcp_rpy}"
        safety_distance="${safety_distance}"
        include_self_collision_geometry="${include_self_collision_geometry}"
        description_pkg="${description_pkg}"
        with_sc="${with_sc}"
      />
    </xacro:if>

    <xacro:if value="${hand and ee_id != 'none' and ee_id != 'franka_hand'}">
      <xacro:include filename="$(find franka_description)/end_effectors/common/ee_with_one_link.xacro"/>
      <xacro:include filename="$(find franka_description)/end_effectors/common/utils.xacro"/>
      <xacro:property name="connection"
        value="${arm_prefix + special_connection if special_connection != '' else link_prefix + 'link8'}"/>
      <xacro:ee_with_one_link
        connected_to="${connection}"
        robot_type="${robot_type}"
        arm_prefix="${arm_prefix}"
        no_prefix="${no_prefix}"
        ee_id="${ee_id}"
        ee_inertials="${xacro.load_yaml('$(find franka_description)/end_effectors/' + ee_id + '/inertials.yaml')}"
        rpy_ee="${rpy_ee}"
        xyz_ee="${xyz_ee}"
        tcp_xyz="${tcp_xyz_resolved}"
        tcp_rpy="${tcp_rpy}"
        safety_distance="${safety_distance}"
        include_self_collision_geometry="${include_self_collision_geometry}"
        description_pkg="${description_pkg}"
        with_sc="${with_sc}"
      />
    </xacro:if>

  </xacro:macro>
</robot>
