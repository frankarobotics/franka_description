<?xml version="1.0" encoding="utf-8"?>
<!-- Robotiq 2F-85 (ARG85) two-finger gripper, adapted from ros2_robotiq_gripper
     (robotiq_description, Apache 2.0) to the franka_description end-effector API. -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="robotiq_arg85">
  <!-- safety_distance: Minimum safety distance in [m] by which the collision volumes are expanded and which is enforced during robot motions -->
  <xacro:macro name="robotiq_arg85"
               params="connected_to:=''
                       robot_type arm_prefix:=''
                       ee_id:=robotiq_arg85 ee_inertials:=''
                       rpy_ee:='0 0 0'
                       xyz_ee:='0 0 0'
                       tcp_xyz:='0 0 0.15'
                       tcp_rpy:='0 0 0'
                       safety_distance:=0
                       gazebo:=false
                       description_pkg:=franka_description
                       with_sc:=false
                       no_prefix:=false
                       ros2_control:=false
                       use_fake_hardware:=false
                       mock_sensor_commands:=false
                       com_port:=/dev/ttyUSB0">

    <xacro:property name="ee_prefix" default="robot_"/>
    <xacro:unless value="${robot_type == ''}">
      <xacro:property name="ee_prefix" value="${arm_prefix}${robot_type}_" />
    </xacro:unless>

    <!-- Optionally instantiate the gripper ros2_control hardware interface. -->
    <xacro:if value="${ros2_control}">
      <xacro:include filename="$(find franka_description)/end_effectors/robotiq_arg85/robotiq_arg85.ros2_control.xacro"/>
      <xacro:robotiq_arg85_ros2_control
        name="${ee_prefix}robotiq_arg85"
        prefix="${ee_prefix}"
        sim_gazebo="${gazebo}"
        use_fake_hardware="${use_fake_hardware}"
        mock_sensor_commands="${mock_sensor_commands}"
        com_port="${com_port}"/>
    </xacro:if>

    <!-- Mount the gripper base on the flange (or special connection). -->
    <xacro:unless value="${connected_to == ''}">
      <joint name="${ee_prefix}${ee_id}_joint" type="fixed">
        <parent link="${connected_to}" />
        <child link="${ee_prefix}robotiq_85_base_link" />
        <origin xyz="${xyz_ee}" rpy="${rpy_ee}" />
      </joint>
    </xacro:unless>

    <link name="${ee_prefix}robotiq_85_base_link">
      <visual>
        <geometry>
          <mesh filename="package://${description_pkg}/meshes/robot_ee/robotiq_arg85/visual/robotiq_base.dae" />
        </geometry>
      </visual>
      <collision>
        <geometry>
          <mesh filename="package://${description_pkg}/meshes/robot_ee/robotiq_arg85/collision/robotiq_base.stl" />
        </geometry>
      </collision>
      <inertial>
        <origin xyz="0.0 2.274e-05 0.03232288" rpy="0 0 0" />
        <mass value="6.6320197e-01" />
        <inertia ixx="5.1617816e-04" iyy="5.8802208e-04" izz="3.9462776e-04" ixy="2.936e-8" ixz="0.0" iyz="-3.2296e-7" />
      </inertial>
    </link>

    <!-- Define the tcp frame at the grasp point. -->
    <link name="${ee_prefix}${ee_id}_tcp" />
    <joint name="${ee_prefix}${ee_id}_tcp_joint" type="fixed">
      <origin xyz="${tcp_xyz}" rpy="${tcp_rpy}" />
      <parent link="${ee_prefix}robotiq_85_base_link" />
      <child link="${ee_prefix}${ee_id}_tcp" />
    </joint>

    <link name="${ee_prefix}robotiq_85_left_knuckle_link">
      <visual>
        <geometry>
          <mesh filename="package://${description_pkg}/meshes/robot_ee/robotiq_arg85/visual/left_knuckle.dae" />
        </geometry>
      </visual>
      <collision>
        <geometry>
          <mesh filename="package://${description_pkg}/meshes/robot_ee/robotiq_arg85/collision/left_knuckle.stl" />
        </geometry>
      </collision>
      <inertial>
        <origin xyz="0.01213197 0.0002 -0.00058647" rpy="0 0 0" />
        <mass value="1.384773208e-02" />
        <inertia ixx="3.5232e-7" iyy="2.31944e-6" izz="2.23136e-6" ixy="0.0" ixz="1.1744e-7" iyz="0" />
      </inertial>
    </link>

    <link name="${ee_prefix}robotiq_85_right_knuckle_link">
      <visual>
        <geometry>
          <mesh filename="package://${description_pkg}/meshes/robot_ee/robotiq_arg85/visual/right_knuckle.dae" />
        </geometry>
      </visual>
      <collision>
        <geometry>
          <mesh filename="package://${description_pkg}/meshes/robot_ee/robotiq_arg85/collision/right_knuckle.stl" />
        </geometry>
      </collision>
      <inertial>
        <origin xyz="-0.01213197 0.0002 -0.00058647" rpy="0 0 0" />
        <mass value="1.384773208e-02" />
        <inertia ixx="3.5232e-7" iyy="2.31944e-6" izz="2.23136e-6" ixy="0.0" ixz="-1.1744e-7" iyz="0.0" />
      </inertial>
    </link>

    <link name="${ee_prefix}robotiq_85_left_finger_link">
      <visual>
        <geometry>
          <mesh filename="package://${description_pkg}/meshes/robot_ee/robotiq_arg85/visual/left_finger.dae" />
        </geometry>
      </visual>
      <collision>
        <geometry>
          <mesh filename="package://${description_pkg}/meshes/robot_ee/robotiq_arg85/collision/left_finger.stl" />
        </geometry>
      </collision>
      <inertial>
        <origin xyz="0.00346899 -0.00079447 0.01867121" rpy="0 0 0" />
        <mass value="4.260376752e-02" />
        <inertia ixx="1.385792000000000e-05" iyy="1.183208e-05" izz="5.19672e-06" ixy="0.0" ixz="-2.17264e-06" iyz="0.0" />
      </inertial>
    </link>

    <link name="${ee_prefix}robotiq_85_right_finger_link">
      <visual>
        <geometry>
          <mesh filename="package://${description_pkg}/meshes/robot_ee/robotiq_arg85/visual/right_finger.dae" />
        </geometry>
      </visual>
      <collision>
        <geometry>
          <mesh filename="package://${description_pkg}/meshes/robot_ee/robotiq_arg85/collision/right_finger.stl" />
        </geometry>
      </collision>
      <inertial>
        <origin xyz="-0.00346899 -5.53e-06 0.01867121" rpy="0 0 0" />
        <mass value="4.260376752000000e-02" />
        <inertia ixx="1.385792e-05" iyy="1.183208e-05" izz="5.19672e-06" ixy="0.0" ixz="2.17264e-06" iyz="0.0" />
      </inertial>
    </link>

    <link name="${ee_prefix}robotiq_85_left_inner_knuckle_link">
      <visual>
        <geometry>
          <mesh filename="package://${description_pkg}/meshes/robot_ee/robotiq_arg85/visual/left_inner_knuckle.dae" />
        </geometry>
      </visual>
      <collision>
        <geometry>
          <mesh filename="package://${description_pkg}/meshes/robot_ee/robotiq_arg85/collision/left_inner_knuckle.stl" />
        </geometry>
      </collision>
      <inertial>
        <origin xyz="0.01897699 0.00015001 0.02247101" rpy="0 0 0" />
        <mass value="2.969376448e-02" />
        <inertia ixx="9.57136e-06" iyy="8.69056e-06" izz="8.19144e-06" ixy="0.0" ixz="-3.93424e-06" iyz="0.0" />
      </inertial>
    </link>

    <link name="${ee_prefix}robotiq_85_right_inner_knuckle_link">
      <visual>
        <geometry>
          <mesh filename="package://${description_pkg}/meshes/robot_ee/robotiq_arg85/visual/right_inner_knuckle.dae" />
        </geometry>
      </visual>
      <collision>
        <geometry>
          <mesh filename="package://${description_pkg}/meshes/robot_ee/robotiq_arg85/collision/right_inner_knuckle.stl" />
        </geometry>
      </collision>
      <inertial>
        <origin xyz="-0.01926824 5.001e-05 0.02222178" rpy="0 0 0" />
        <mass value="2.969376448e-02" />
        <inertia ixx="9.42456e-06" iyy="8.69056e-06" izz="8.33824e-06" ixy="0.0" ixz="3.9636e-06" iyz="0.0" />
      </inertial>
    </link>

    <link name="${ee_prefix}robotiq_85_left_finger_tip_link">
      <visual>
        <geometry>
          <mesh filename="package://${description_pkg}/meshes/robot_ee/robotiq_arg85/visual/left_finger_tip.dae" />
        </geometry>
      </visual>
      <collision>
        <geometry>
          <mesh filename="package://${description_pkg}/meshes/robot_ee/robotiq_arg85/collision/left_finger_tip.stl" />
        </geometry>
        <surface>
          <friction>
          <ode>
            <mu1>100000.0</mu1>
            <mu2>100000.0</mu2>
          </ode>
          </friction>
          <contact>
          <ode>
            <kp>1e+5</kp>
            <kd>1</kd>
            <soft_cfm>0</soft_cfm>
            <soft_erp>0.2</soft_erp>
            <minDepth>0.002</minDepth>
            <maxVel>0</maxVel>
          </ode>
          </contact>
        </surface>
      </collision>
      <inertial>
        <origin xyz="-0.01456706 -0.0008 0.01649701" rpy="0 0 0" />
        <mass value="4.268588744e-02" />
        <inertia ixx="1.048152e-05" iyy="1.197888e-05" izz="4.22784e-06" ixy="0.0" ixz="3.5232e-6" iyz="0.0" />
      </inertial>
    </link>

    <link name="${ee_prefix}robotiq_85_right_finger_tip_link">
      <visual>
        <geometry>
          <mesh filename="package://${description_pkg}/meshes/robot_ee/robotiq_arg85/visual/right_finger_tip.dae" />
        </geometry>
      </visual>
      <collision>
        <geometry>
          <mesh filename="package://${description_pkg}/meshes/robot_ee/robotiq_arg85/collision/right_finger_tip.stl" />
        </geometry>
        <surface>
          <friction>
          <ode>
            <mu1>100000.0</mu1>
            <mu2>100000.0</mu2>
          </ode>
          </friction>
          <contact>
          <ode>
            <kp>1e+5</kp>
            <kd>1</kd>
            <soft_cfm>0</soft_cfm>
            <soft_erp>0.2</soft_erp>
            <minDepth>0.002</minDepth>
            <maxVel>0</maxVel>
          </ode>
          </contact>
        </surface>
      </collision>
      <inertial>
        <origin xyz="0.01456706 5e-05 0.01649701" rpy="0 0 0" />
        <mass value="4.268588744e-02" />
        <inertia ixx="1.048152e-05" iyy="1.197888e-05" izz="4.22784e-06" ixy="0.0" ixz="-3.5232e-06" iyz="0.0" />
      </inertial>
    </link>

    <joint name="${ee_prefix}robotiq_85_left_knuckle_joint" type="revolute">
      <parent link="${ee_prefix}robotiq_85_base_link" />
      <child link="${ee_prefix}robotiq_85_left_knuckle_link" />
      <axis xyz="0 -1 0" />
      <origin xyz="0.03060114 0.0 0.05490452" rpy="0 0 0" />
      <limit lower="0.0" upper="0.8" velocity="0.5" effort="50" />
    </joint>

    <joint name="${ee_prefix}robotiq_85_right_knuckle_joint" type="revolute">
      <parent link="${ee_prefix}robotiq_85_base_link" />
      <child link="${ee_prefix}robotiq_85_right_knuckle_link" />
      <axis xyz="0 -1 0" />
      <origin xyz="-0.03060114 0.0 0.05490452" rpy="0 0 0" />
      <limit lower="-0.8" upper="0.0" velocity="0.5" effort="50" />
      <mimic joint="${ee_prefix}robotiq_85_left_knuckle_joint" multiplier="-1" />
    </joint>

    <joint name="${ee_prefix}robotiq_85_left_finger_joint" type="fixed">
      <parent link="${ee_prefix}robotiq_85_left_knuckle_link" />
      <child link="${ee_prefix}robotiq_85_left_finger_link" />
      <origin xyz="0.03152616 0.0 -0.00376347" rpy="0 0 0" />
    </joint>

    <joint name="${ee_prefix}robotiq_85_right_finger_joint" type="fixed">
      <parent link="${ee_prefix}robotiq_85_right_knuckle_link" />
      <child link="${ee_prefix}robotiq_85_right_finger_link" />
      <origin xyz="-0.03152616 0.0 -0.00376347" rpy="0 0 0" />
    </joint>

    <joint name="${ee_prefix}robotiq_85_left_inner_knuckle_joint" type="revolute">
      <parent link="${ee_prefix}robotiq_85_base_link" />
      <child link="${ee_prefix}robotiq_85_left_inner_knuckle_link" />
      <axis xyz="0 -1 0" />
      <origin xyz="0.0127 0.0 0.06142" rpy="0 0 0" />
      <mimic joint="${ee_prefix}robotiq_85_left_knuckle_joint" />
      <limit lower="0.0" upper="0.8" velocity="0.5" effort="50" />
    </joint>

    <joint name="${ee_prefix}robotiq_85_right_inner_knuckle_joint" type="revolute">
      <parent link="${ee_prefix}robotiq_85_base_link" />
      <child link="${ee_prefix}robotiq_85_right_inner_knuckle_link" />
      <axis xyz="0 -1 0" />
      <origin xyz="-0.0127 0.0 0.06142" rpy="0 0 0" />
      <mimic joint="${ee_prefix}robotiq_85_left_knuckle_joint" multiplier="-1" />
      <limit lower="-0.8" upper="0.0" velocity="0.5" effort="50" />
    </joint>

    <joint name="${ee_prefix}robotiq_85_left_finger_tip_joint" type="revolute">
      <parent link="${ee_prefix}robotiq_85_left_finger_link" />
      <child link="${ee_prefix}robotiq_85_left_finger_tip_link" />
      <axis xyz="0 -1 0" />
      <origin xyz="0.00563134 0.0 0.04718515" rpy="0 0 0" />
      <mimic joint="${ee_prefix}robotiq_85_left_knuckle_joint" multiplier="-1" />
      <limit lower="-0.8" upper="0.0" velocity="0.5" effort="50" />
    </joint>

    <joint name="${ee_prefix}robotiq_85_right_finger_tip_joint" type="revolute">
      <parent link="${ee_prefix}robotiq_85_right_finger_link" />
      <child link="${ee_prefix}robotiq_85_right_finger_tip_link" />
      <axis xyz="0 -1 0" />
      <origin xyz="-0.00563134 0.0 0.04718515" rpy="0 0 0" />
      <mimic joint="${ee_prefix}robotiq_85_left_knuckle_joint" />
      <limit lower="0.0" upper="0.8" velocity="0.5" effort="50" />
    </joint>
  </xacro:macro>
</robot>
